<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>اختبر نفسك - مبادئ التسويق</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#f4f6f4;--card:#fff;--tx:#111;--mut:#555;--bd:#d5dbd5;--pr:#0a7a45;--ok:#d9f2e3;--okb:#0a7a45;--no:#fbdede;--nob:#c0392b}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#121513;--card:#1c211e;--tx:#f1f1f1;--mut:#aab;--bd:#364038;--pr:#2fbf78;--ok:#14382a;--okb:#2fbf78;--no:#3d1b1b;--nob:#ef6b5b}}
:root[data-theme="dark"]{--bg:#121513;--card:#1c211e;--tx:#f1f1f1;--mut:#aab;--bd:#364038;--pr:#2fbf78;--ok:#14382a;--okb:#2fbf78;--no:#3d1b1b;--nob:#ef6b5b}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font-family:Tahoma,Arial,sans-serif;line-height:1.6}
.w{max-width:640px;margin:0 auto;padding:16px}
h1{font-size:22px;margin:8px 0 4px;text-align:center}
.s{color:var(--mut);text-align:center;margin:0 0 16px;font-size:14px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:18px;margin-bottom:12px}
.bar{height:8px;background:var(--bd);border-radius:6px;overflow:hidden;margin-bottom:6px}
.bar i{display:block;height:100%;background:var(--pr);transition:width .3s}
.meta{display:flex;justify-content:space-between;font-size:13px;color:var(--mut);margin-bottom:10px}
.q{font-size:18px;font-weight:700;margin:0 0 14px}
.o{display:block;width:100%;text-align:right;font:inherit;color:var(--tx);background:var(--card);border:2px solid var(--bd);border-radius:10px;padding:12px 14px;margin-bottom:8px;cursor:pointer}
.o:hover:not(:disabled){border-color:var(--pr)}
.o.ok{background:var(--ok);border-color:var(--okb)}
.o.no{background:var(--no);border-color:var(--nob)}
.o:disabled{cursor:default}
.b{display:block;width:100%;background:var(--pr);color:#fff;border:0;border-radius:10px;padding:13px;font:inherit;font-weight:700;cursor:pointer}
.big{font-size:44px;font-weight:800;text-align:center;margin:6px 0}
.r{border-top:1px solid var(--bd);padding:10px 0;font-size:15px}
.r b{color:var(--okb)}
.cr{text-align:center;color:var(--mut);font-size:12px;margin:18px 0 8px;direction:ltr}
.tag{font-size:12px;border:1px solid var(--bd);border-radius:20px;padding:1px 10px}
</style></head><body><div class="w">
<h1>اختبر نفسك: مبادئ التسويق</h1>
<p class="s">20 اختيار من متعدد + 10 صح وخطأ</p>
<div id="app"></div>
<div class="cr">© Hassan.Faisal</div></div>
<script>
// [سؤال، الصحيحة، خطأ1، خطأ2، خطأ3]
const M=[
["نشاط إنساني موجه إلى إشباع الحاجات والرغبات من خلال عمليات التبادل، هذا تعريف:","Kotler 2004","AMA 1960","AMA 2003","ماسلو"],
["حالة من الشعور بالحرمان عند الفرد تسمى:","الحاجات","الرغبات","الطلب","التبادل"],
["الوسائل التي يتم من خلالها إشباع حاجات المستهلك هي:","الرغبات","الحاجات","الطلب","المنتجات"],
["الطلب يرتبط بـ:","القدرة الشرائية","عدد السكان","الإعلان","الجودة فقط"],
["المرحلة التي تقول إن «المنتج الجيد يبيع نفسه» هي:","المفهوم المرتبط بالمنتج","المفهوم الإنتاجي","المفهوم البيعي","المفهوم التسويقي"],
["المرحلة التي بدأت من الثورة الصناعية وانتهت بالكساد الكبير 1929:","المفهوم الإنتاجي","المفهوم البيعي","المفهوم التسويقي","المفهوم الاجتماعي"],
["نقطة البداية في المفهوم التسويقي هي:","السوق","المصنع","المنتجات الحالية","حجم المبيعات"],
["فشل المنظمات في تكييف نفسها مع السوق (مثل كاتيل وأركسون) يسمى:","قصر النظر التسويقي","التسويق الأخضر","التسويق الأخلاقي","التسويق المتكامل"],
["من عناصر المزيج التسويقي الخدمية الإضافية:","الناس","السعر","التوزيع","الترويج"],
["اختراق السوق في مصفوفة المنتج والسوق يعني:","منتجات حالية في أسواق حالية","منتجات جديدة في أسواق جديدة","منتجات جديدة في أسواق حالية","منتجات حالية في أسواق جديدة"],
["البيئة التي لا يمكن السيطرة عليها هي:","الكلية (الخارجية)","الداخلية","المزيج التسويقي","أهداف المنشأة"],
["مرحلة تنخفض فيها القوة الشرائية وتخفض الأسعار (الدورة الاقتصادية):","الركود","الرواج","الانتعاش","الازدهار"],
["السوق الذي يشتري بهدف إعادة التصنيع أو إعادة البيع:","السوق الصناعية","السوق الاستهلاكية","سوق الأسر","سوق الأفراد"],
["الاستراتيجية المناسبة للشركات ذات الموارد المحدودة:","التجزئة المركزة","التجزئة المتنوعة","التجزئة المتمايزة","لا شيء مما سبق"],
["قاعدة (80-20) تُستخدم في تجزئة السوق حسب:","معدل الاستهلاك","درجة الولاء","الموقف الشرائي","المناخ"],
["مثال على السلوك الشرائي المكثف:","أجهزة المعامل التقنية","السكر","معجون الأسنان","الأرز"],
["الشخص الذي يقترح أو يفكر في شراء سلعة أو خدمة معينة هو:","المبادر","المؤثر","المشتري","المستخدم"],
["أول مرحلة في عملية اتخاذ قرار الشراء:","إدراك الحاجة","البحث عن المعلومات","تقييم البدائل","اتخاذ القرار"],
["من الجماعات المرجعية الأولية:","العائلة والأصدقاء","النقابات","الجماعات المهنية","وسائل الإعلام"],
["AIO في نمط الحياة تعني:","الأنشطة والاهتمامات والآراء","الأهداف والأفكار والأولويات","الأسعار والإعلان والتوزيع","الاحتياجات والرغبات والطلب"]
];
// [العبارة، صح؟]
const T=[
["الحاجات محدودة والرغبات متعددة.",1],
["في المفهوم البيعي يكون الطلب أكبر من العرض.",0],
["في المفهوم الإنتاجي يكون الطلب أكبر من العرض.",1],
["المنفعة الزمانية والمكانية والحيازة توفرها إدارة التسويق.",1],
["الشركة نظام مغلق لا تتأثر بالبيئة الخارجية.",0],
["التجزئة المركزة توجه برنامجاً تسويقياً واحداً إلى قطاع سوقي واحد.",1],
["استراتيجية توحيد السوق تفترض أن المستهلكين متفاوتون في رغباتهم.",0],
["السلوك الشرائي الروتيني ارتباطه عالٍ ويحتاج بحثاً مكثفاً.",0],
["إذا كانت القيمة الحقيقية للمنتج أقل من الأداء المتوقع يحصل عدم رضا.",1],
["الثقافة الفرعية مثل الجماعات الدينية والقومية.",1]
];
const sh=a=>{a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]]}return a};
const Q=[...M.map(m=>({t:"mc",q:m[0],a:m[1],o:sh(m.slice(1))})),...T.map(t=>({t:"tf",q:t[0],a:t[1]?"صح":"خطأ",o:["صح","خطأ"]}))];
let i,sc,wr,done;
const app=document.getElementById("app");
const esc=s=>s.replace(/&/g,"&amp;").replace(/</g,"&lt;");
function start(){i=0;sc=0;wr=[];show()}
function show(){
 if(i>=Q.length)return end();
 const q=Q[i];done=false;
 app.innerHTML=`<div class="card"><div class="bar"><i style="width:${i/Q.length*100}%"></i></div>
 <div class="meta"><span>سؤال ${i+1} من ${Q.length}</span><span class="tag">${q.t=="mc"?"اختيار من متعدد":"صح أو خطأ"}</span></div>
 <p class="q">${esc(q.q)}</p><div id="os"></div><div id="nx"></div></div>`;
 const os=document.getElementById("os");
 q.o.forEach(t=>{const b=document.createElement("button");b.className="o";b.textContent=t;b.onclick=()=>pick(b,t);os.appendChild(b)});
}
function pick(b,t){
 if(done)return;done=true;const q=Q[i];
 [...document.querySelectorAll(".o")].forEach(x=>{x.disabled=true;if(x.textContent==q.a)x.classList.add("ok")});
 if(t==q.a)sc++;else{b.classList.add("no");wr.push(q)}
 const n=document.createElement("button");n.className="b";n.textContent=i==Q.length-1?"عرض النتيجة":"التالي";
 n.onclick=()=>{i++;show()};document.getElementById("nx").appendChild(n);n.focus();
}
function end(){
 const p=Math.round(sc/Q.length*100);
 app.innerHTML=`<div class="card"><div class="bar"><i style="width:100%"></i></div>
 <div class="big">${sc} / ${Q.length}</div><p class="s">${p}% — ${p>=90?"ممتاز، جاهز للاختبار":p>=70?"جيد، راجع أخطاءك":"تحتاج مراجعة أكثر"}</p>
 <button class="b" onclick="start()">إعادة الاختبار</button></div>
 ${wr.length?`<div class="card"><b>أسئلة أخطأت فيها (${wr.length}):</b>${wr.map(q=>`<div class="r">${esc(q.q)}<br>الجواب الصحيح: <b>${esc(q.a)}</b></div>`).join("")}</div>`:""}`;
 window.scrollTo(0,0);
}
start();
</script></body></html>
